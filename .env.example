# RouterOS connection. Keep the real .env file out of Git.
MIKROTIK_HOST=10.0.0.1
MIKROTIK_PORT=443
MIKROTIK_USERNAME=mtmgr-read
MIKROTIK_PASSWORD=
MIKROTIK_WRITE_USERNAME=mtmgr-write
MIKROTIK_WRITE_PASSWORD=
MIKROTIK_VERIFY_SSL=true
MIKROTIK_CONNECT_TIMEOUT_MS=3000
MIKROTIK_READ_TIMEOUT_MS=5000

# true keeps development fully local and makes no RouterOS request.
# Set false to use RouterOS REST reads; only the explicitly enabled Phase 4
# device block writer can mutate the real router.
MIKROTIK_MOCK_MODE=true

# Keep both false by default. Real RouterOS writes require both switches and
# the separate write credentials below. Mock mode still permits simulations.
MIKROTIK_WRITE_ENABLED=false
MIKROTIK_DEVICE_BLOCK_WRITES_ENABLED=false

# Optional local listener overrides
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_DATA_DIR=../data
