# RouterOS connection. Keep the real .env file out of Git.
MIKROTIK_HOST=10.0.0.1
MIKROTIK_PORT=443
MIKROTIK_USERNAME=mtmgr
MIKROTIK_PASSWORD=replace-with-a-local-secret
MIKROTIK_VERIFY_SSL=false

# true is the safe default for local development. Set false only in Phase 2+
# after the RouterOS read-only integration has been configured and validated.
MIKROTIK_MOCK_MODE=true

# Optional local listener overrides
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_DATA_DIR=../data
