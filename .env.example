# RouterOS connection. Keep the real .env file out of Git.
MIKROTIK_HOST=10.0.0.1
MIKROTIK_PORT=443
MIKROTIK_USERNAME=mtmgr
MIKROTIK_PASSWORD=replace-with-a-local-secret
MIKROTIK_VERIFY_SSL=true
MIKROTIK_CONNECT_TIMEOUT_MS=3000
MIKROTIK_READ_TIMEOUT_MS=5000

# true keeps development fully local and makes no RouterOS request.
# Set false to use the Phase 2 RouterOS REST read-only integration.
MIKROTIK_MOCK_MODE=true

# Keep false. In Phase 2 the real gateway has no RouterOS write implementation
# even if this is changed to true. Mock mode still permits simulated mutations.
MIKROTIK_WRITE_ENABLED=false

# Optional local listener overrides
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_DATA_DIR=../data
